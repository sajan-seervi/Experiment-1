#re.search()
import re
msg = "device connected to 5g network"
r = re.search("connected", msg)
if r:
    print("2. connected found")
else:
    print("connected not found")
#OUTPUT 
2. connected found


#re.findall()
import re
data = "temp:24 humidity:60 pressure:102"
r = re.findall(r"[0-9]+", data)
print(r)
#OUTPUT 
['24', '60', '102']


#re.finditer()
import re
text = "cat bat mat"
pattern = "bat"
matches = re.finditer(pattern, text)
for m in matches:
    print("4. match:", m.group())
#OUTPUT 
4. match: bat


#re.split()
import re
text = "apple, banana; orange grape"
pattern = r"[,; ]+"
result = re.split(pattern, text)
print(result)
#OUTPUT 
['apple', 'banana', 'orange', 'grape']


#re.sub()
import re
text = "My phone number is 12345"
pattern = r"\d"
result = re.sub(pattern, "*", text)
print(result)
#OUTPUT 
My phone number is *****


