import re
date = input("Enter a date (DD/MM/YYYY): ")
pattern = r"\d{2}/\d{2}/\d{4}"
if re.fullmatch(pattern, date):
    print("Valid date format")
else:
    print("Invalid date format")
#OUTPUT 
Enter a date (DD/MM/YYYY): 02/02/2025
Valid date format
