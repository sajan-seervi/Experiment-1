#CODE:- 
import pandas as pd
import numpy as np

data = {
    "Name": ["Sajan", "Yadav", "Shaksham", None],
    "Marks": [85, 90, None, 75]
}
df = pd.DataFrame(data)
print("Original Data:")
print(df)

df["Name"].fillna("Unknown", inplace=True)
df["Marks"].fillna(df["Marks"].mean(), inplace=True)

df.drop_duplicates(inplace=True)

print("\nCleaned Data:")
print(df)


